<Project>
  <!-- One place to change the .NET version. Use net8.0, net9.0 or net10.0 (net10.0 is set now; if you use another SDK also change the 10.* package versions in the csproj files) to match the SDK you installed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
